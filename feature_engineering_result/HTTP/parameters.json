{
  "source": "HTTP",
  "input_mode": "csv_snapshot",
  "documents": 1,
  "tokenizer": "nltk.word_tokenize(text.lower())",
  "word2vec": {
    "sg": 0,
    "vector_size": 100,
    "window": 5,
    "min_count": 1,
    "epochs": 5,
    "seed": 1,
    "workers": 1
  },
  "fasttext": {
    "sg": 1,
    "vector_size": 100,
    "window": 5,
    "min_count": 1,
    "min_n": 3,
    "max_n": 6,
    "epochs": 10,
    "bucket": 20000,
    "seed": 1,
    "workers": 1
  },
  "umap": {
    "random_state": 42,
    "n_jobs": 1,
    "metric": "euclidean",
    "n_neighbors": 15
  }
}